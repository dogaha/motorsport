{
  "datasets": [
    {
      "name": "e94ae645",
      "displayName": "fct_sessions",
      "config": {
        "source": "motorsport.gold.fct_section_times",
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ],
        "filter": "selected_driver_id IS NULL OR driver_id = selected_driver_id",
        "version": "1.1",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "parameters": [
          {
            "name": "selected_driver_id",
            "dataType": "INT",
            "default": null
          }
        ]
      }
    },
    {
      "name": "14e89b6a",
      "displayName": "fct_section_times_expanded",
      "queryLines": [
        "SELECT \r\n",
        "    st.*,\r\n",
        "    ROUND(section_duration_seconds,2) AS rounded_section_duration_seconds,\r\n",
        "    d.driver_full_name,\r\n",
        "    v.vehicle_make,\r\n",
        "    v.vehicle_model,\r\n",
        "    ts.section_type,\r\n",
        "    t.track_name,\r\n",
        "    ROUND(\r\n",
        "        SUM(ROUND(section_duration_seconds,2)) OVER (PARTITION BY st.session_id,st.lap),\r\n",
        "        2\r\n",
        "    ) AS lap_duration_seconds\r\n",
        "FROM motorsport.gold.fct_section_times st \r\n",
        "LEFT JOIN motorsport.gold.dim_drivers d\r\n",
        "    ON st.driver_id = d.driver_id\r\n",
        "LEFT JOIN motorsport.gold.dim_vehicles v\r\n",
        "    ON st.vehicle_id = v.vehicle_id\r\n",
        "LEFT JOIN motorsport.gold.dim_tracks t\r\n",
        "    ON st.track_id = t.track_id\r\n",
        "LEFT JOIN motorsport.gold.dim_track_sections ts\r\n",
        "    ON st.track_id = ts.track_id \r\n",
        "    AND st.section_number = ts.section_number\r\n",
        "WHERE st.lap != 0;"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "015b789d",
      "displayName": "fct_warning_summary",
      "queryLines": [
        "WITH expanded_fct_warning AS (\n",
        "  SELECT\n",
        "    w.*,\n",
        "    CASE\n",
        "      WHEN w.value < w.normal_min THEN 'overload'\n",
        "      ELSE 'underload'\n",
        "    END AS category\n",
        "  FROM\n",
        "    motorsport.gold.fct_warning w\n",
        ")\n",
        "SELECT\n",
        "  session_id,\n",
        "  sensor_name,\n",
        "  COUNT(*) AS total_warnings,\n",
        "  COUNT(*) * 1.0 / SUM(COUNT(*)) OVER (PARTITION BY session_id) AS total_warnings_percentage,\n",
        "  CASE\n",
        "    WHEN COUNT(*) * 1.0 / SUM(COUNT(*)) OVER (PARTITION BY session_id) > 0.02 THEN 'Above 2.0%'\n",
        "    ELSE 'Below 2.0%'\n",
        "  END AS warning_flag,\n",
        "  COUNT(CASE WHEN category = 'overload' THEN 1 END) AS above_threshold,\n",
        "  COUNT(CASE WHEN category = 'underload' THEN 1 END) AS below_threshold\n",
        "FROM\n",
        "  expanded_fct_warning\n",
        "GROUP BY\n",
        "  session_id,\n",
        "  sensor_name"
      ]
    }
  ],
